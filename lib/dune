(library
  (name ocamlbricks)
  ;; (public_name ocamlbricks)
  ;; ocamlbricks modules #load include_type_definitions_p4.cmo (built by the (rule)s below);
  ;; -I points into dune's own build dir instead of the former hand-linked top-level _build/.
  (preprocessor_deps include_type_definitions_p4.cmo)
  (preprocess (action (run camlp4of -I ../../../../_build/default/lib/ %{read-lines:camlp4of-flags.cfg} %{input-file})))
  (libraries str unix threads inotify lablgtk3)
  ;;(library_flags -linkall -cclib -locamlbricks_stubs)
  ;; ---
  (foreign_stubs
    (language c)
    (names gettext-c-wrapper waitpid-c-wrapper does-process-exist-c-wrapper)
    ;;(flags -I/blah/include)
    )
  ;;(c_library_flags (-lblah))
  ;; ---
  ;; ---
  ;; --- Do not compile preprocessor with dune:
  ;; ---

  (modules (:standard
     \ common_tools_for_preprocessors
       include_as_string_p4
       include_type_definitions_p4
       option_extract_p4
       log_module_loading_p4
       raise_p4 where_p4
       gettext_extract_pot_p4
       ))

) ;library

;; --------------------------------------------------------------------------
;; camlp4 syntax-extension preprocessors, built by dune (formerly by lib/Makefile,
;; targets MANUALLY_PRE_MAKE_IN_build). Uniform recipe: bytecode .cmi then .cmo via
;; camlp4of, in a single (progn) so the .cmi is available to the .cmo compilation.
;; The -D flags are read from camlp4of-flags.cfg — the same single source of truth as the
;; (preprocess) stanza above; harmless where IFDEF is unused.
;; `camlp-streams' provides the `Stream' module, removed from the Stdlib by OCaml 5.0 and used
;; by include_type_definitions_p4.ml; `unix' is needed by include_as_string_p4.ml (Unix.openfile,
;; Unix.read), whose lib directory is no longer in the default search path since OCaml 5.0 —
;; without it the build raises the alert `ocaml_deprecated_auto_include'. Both are kept in the
;; -package list of every rule to preserve the uniformity of the recipe (harmless for the
;; preprocessors that do not use them).
;; Result: `dune build` alone produces the .cmo that bin/dune loads at preprocess time.
;; --------------------------------------------------------------------------
(rule
  (targets where_p4.cmi where_p4.cmo)
  (deps CAMLP4/where_p4.mli CAMLP4/where_p4.ml)
  (action (progn
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o where_p4.cmi CAMLP4/where_p4.mli)
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4 -I .
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o where_p4.cmo CAMLP4/where_p4.ml))))
(rule
  (targets option_extract_p4.cmi option_extract_p4.cmo)
  (deps CAMLP4/option_extract_p4.mli CAMLP4/option_extract_p4.ml)
  (action (progn
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o option_extract_p4.cmi CAMLP4/option_extract_p4.mli)
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4 -I .
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o option_extract_p4.cmo CAMLP4/option_extract_p4.ml))))
(rule
  (targets raise_p4.cmi raise_p4.cmo)
  (deps CAMLP4/raise_p4.mli CAMLP4/raise_p4.ml CAMLP4/common_tools_for_preprocessors.ml)
  (action (progn
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o raise_p4.cmi CAMLP4/raise_p4.mli)
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4 -I .
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o raise_p4.cmo CAMLP4/raise_p4.ml))))
(rule
  (targets log_module_loading_p4.cmi log_module_loading_p4.cmo)
