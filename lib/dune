    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o log_module_loading_p4.cmi CAMLP4/log_module_loading_p4.mli)
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4 -I .
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
       -o log_module_loading_p4.cmo CAMLP4/log_module_loading_p4.ml))))
(rule
  (targets include_type_definitions_p4.cmi include_type_definitions_p4.cmo)
  (deps CAMLP4/include_type_definitions_p4.mli CAMLP4/include_type_definitions_p4.ml)
  (action (progn
    (run ocamlfind ocamlc -package camlp4,camlp-streams,unix -c -I +camlp4
       -pp "camlp4of %{read-lines:camlp4of-flags.cfg}"
