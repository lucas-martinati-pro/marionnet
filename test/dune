;; Independent test programs, all run by `dune test':
;;   marionnet      -- the fixes applied to Ocamlbricks.Network (pilotage-par-script, ep. 2)
;;   xforest_json   -- the JSON codec of Ocamlbricks.Xforest (migration-marshal-to-text, ep. 2)
;;   treeview_json  -- the JSON codecs of a treeview and of its counters (idem, ep. 3)
;;   project_archive -- atomic archive replacement and real tar failures (no display)
;; utf_8_reference is not a test program but a module shared by the last two: the
;; INDEPENDENT UTF-8 validator against which their output is checked (never the one the
;; codecs use to decide the base64 fallback, which would be circular).
;; marionnet_base holds treeview_row / treeview_counters: the data a treeview saves, and
;; their codecs, deliberately kept out of the Gtk+ module Treeview so that they can be
;; tested without a display.
(tests
 (names marionnet xforest_json treeview_json project_archive_test sketch_renderer_test sketch_hit_map_test edit_files_test task_guard_test)
 (modules marionnet xforest_json treeview_json utf_8_reference project_archive_test sketch_renderer_test sketch_hit_map_test edit_files_test task_guard_test)
 (libraries ocamlbricks marionnet_base)
 )

;; Installer presentation exercised with stand-ins for every privileged command.
(rule
 (alias runtest)
 (deps install_presentation_test.py ../install.sh ../dist/install.sh)
 (action (run python3 %{dep:install_presentation_test.py})))

(rule
 (alias runtest)
 (deps release_version_test.py ../dist/sync-release-version.py)
 (action (run python3 %{dep:release_version_test.py})))

(rule
 (alias runtest)
 (deps update_presentation_test.py ../bin/scripts/marionnet-update)
 (action (run python3 %{dep:update_presentation_test.py})))

(rule
 (alias runtest)
 (deps terminal_wrapper_test.py ../bin/scripts/marionnet-xterm.sh)
 (action (run python3 %{dep:terminal_wrapper_test.py})))

(rule
 (alias runtest)
 (deps cleanup_test.py ../bin/scripts/marionnet-cleanup)
 (action (run python3 %{dep:cleanup_test.py})))
