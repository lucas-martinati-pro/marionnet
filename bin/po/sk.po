#~ msgid ""
#~ "Run directories left in %s by past sessions: %d. Each holds the working "
#~ "copy of a project that was not saved, which is why Marionnet never "
#~ "removes any of them by itself; some may even belong to another Marionnet "
#~ "running right now. To sort out the abandoned ones and remove them, run "
#~ "the script useful-scripts/marionnet-cleanup of the Marionnet sources with "
#~ "the option --purge-dirs."
#~ msgstr ""
#~ "Adresáre relácií zanechané v %s: %d. Každý z nich obsahuje pracovnú kópiu "
#~ "projektu, ktorý nebol uložený; preto Marionnet nikdy žiadny sám "
#~ "neodstráni. Niektoré môžu dokonca patriť inému práve bežiacemu "
#~ "Marionnetu. Ak chcete vytriediť opustené a odstrániť ich, spustite skript "
#~ "useful-scripts/marionnet-cleanup zo zdrojov Marionnetu s voľbou --purge-"
#~ "dirs."

#~ msgid ""
#~ "Run directories left in %s by past sessions: %d. Each holds the working "
#~ "copy of a project that was not saved, which is why Marionnet never "
#~ "removes any of them by itself; some may even belong to another Marionnet "
#~ "running right now. You may sort them out whenever you like, with the "
#~ "command:\n"
#~ "\n"
#~ "marionnet-cleanup --archive-dirs DIRECTORY --purge-dirs\n"
#~ "\n"
#~ "which first saves each of those projects as a .mar file into DIRECTORY, "
#~ "then removes the directories no live session is using.%s"
#~ msgstr ""
#~ "Adresáre relácií zanechané v %s: %d. Každý z nich obsahuje pracovnú kópiu "
#~ "projektu, ktorý nebol uložený; preto Marionnet nikdy žiadny sám "
#~ "neodstráni. Niektoré môžu dokonca patriť inému práve bežiacemu "
#~ "Marionnetu. Poradiť si s nimi môžete kedykoľvek sami, príkazom:\n"
#~ "\n"
#~ "marionnet-cleanup --archive-dirs ADRESÁR --purge-dirs\n"
#~ "\n"
#~ "ktorý najprv uloží každý z týchto projektov ako súbor .mar do ADRESÁRA a "
#~ "potom odstráni adresáre, ktoré nepoužíva žiadna bežiaca relácia.%s"

