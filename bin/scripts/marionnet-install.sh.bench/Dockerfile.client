# The client half: a bare Debian, so that what the script needs is MEASURED instead of
# assumed. Everything the script calls on the fetching path is installed here and nothing
# else -- wget, tar, xz-utils, coreutils. In particular there is no marionnet, no opam, no
# repository: the script is copied in alone, which is exactly how it will be downloaded.
#
# sha256sum (coreutils) is used by BOTH sides since episode 8: the script checks a
# downloaded artefact against the published SHA256SUMS, and the bench checks the bench.
# It is part of the essential coreutils of any Debian, so there is nothing to install --
# which is precisely the point of not installing it here: if it were missing, this image
# would say so.
# The base image is a build argument since episode 12: the four boxes of the roadmap.
# Nothing else in this file depends on the distribution -- the three packages below are
# called the same on Debian and on Ubuntu.
ARG BASE_IMAGE=debian:trixie-slim
FROM ${BASE_IMAGE}

RUN apt-get update \
 && apt-get install -y --no-install-recommends wget xz-utils tar \
 && rm -rf /var/lib/apt/lists/*
