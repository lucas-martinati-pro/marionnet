     (glob_files "images/leds/hub/*")
     (glob_files "images/leds/router/*")
     (glob_files "images/leds/switch/*")
     (glob_files "images/leds/world_gateway/*")
     ;; ---
     )
  (section share)
  (package marionnet) ;;; optional
 )


