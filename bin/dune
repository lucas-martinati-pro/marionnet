(env
  (dev     (flags (:standard -w +42 -w -27 -w -67 -w -3 -w -6 -w -16 -w -32)))
  (release (ocamlopt_flags (:standard -O3)))
  )
;; ---
(include_subdirs unqualified)
;; ---
;;(dirs :standard )

;; ---
;; --- GENERATED META MODULES: version.ml & meta.ml
;; ---
;; Formerly generated by the Makefile invoking the bash makers before `dune build`
;; (piège n°1). Dune now runs the makers itself as (rule)s, so `dune build` alone
;; suffices on a fresh clone. (universe) disables the sandbox (the makers need the
;; real repo for `git rev-parse` / `git log`) AND forces a re-run every build, so
;; revision / build date track HEAD instead of being cached against META/CONFIGME.
;; The source tree must NOT contain version.ml / meta.ml (a rule target cannot also
;; be a source file — they are gitignored and produced under _build/).
;; ---
(rule
  (target version.ml)
  (deps
    (universe)
    (file version.ml.maker.sh)
    (file ../META))
  (action (run bash version.ml.maker.sh ../META version.ml)))

(rule
  (target meta.ml)
  (deps
    (universe)
    (file meta.ml.maker.sh)
    (file ../META)
    (file ../CONFIGME.choice))
  (action (run bash meta.ml.maker.sh ../META ../CONFIGME.choice meta.ml)))

;; ---
;; --- The camlp4 preprocess recipe is identical for every stanza below (global
;; --- option_extract_p4 / raise_p4 / log_module_loading_p4, plus the per-file
;; --- #load-able where_p4 / include_type_definitions_p4 / include_as_string_p4
;; --- staged as deps). preprocessor_deps build the .cmo (from lib/dune (rule)s)
;; --- before camlp4of runs; the first -I points into dune's build dir. No manual -cclib
;; --- -locamlbricks_stubs: linking ocamlbricks (which declares (foreign_stubs ...))
;; --- pulls its C stub archive in automatically.
;; ---
;; --- The second -I is read from ../lib/camlp4of-include.cfg, a one-line file GENERATED by a
;; --- (rule) of lib/dune that holds the ABSOLUTE path of _build/default/lib. It is dead weight
;; --- for dune itself, but it is what makes this exact command replayable outside dune's build
;; --- tree — namely by merlin / ocaml-lsp, which is handed this very (preprocess (action ...))
;; --- as an (FLG (-pp ...)) and runs it after chdir'ing into the source file's directory.
;; --- Without it camlp4of exits 2 there and every #load'ing file of bin/ shows a bogus
;; --- "Syntax error". Full rationale on the rule in lib/dune.
;; ---

;; ---
;; --- SHARED LIBRARY: modules shared by the marionnet_tap library and the GUI
;; ---   executable (no lablgtk). Dune forbids a module in two stanzas of one
;; ---   directory, so they live in a single library both link. (wrapped false)
;; ---   keeps the flat module names the sources reference unqualified
;; ---   (Marionnet_log, ...). Formerly named marionnet_common, "what the GUI
;; ---   and the root daemon share" — the daemon is gone (chantier
;; ---   marionnet-daemon-elimination, episode 4).
;; ---
(library
  (name marionnet_base)
  (wrapped false)
  ;; treeview_row / treeview_counters: the DATA a treeview saves (a row, its items, the
  ;; counters of `ifconfig') together with their JSON codec, which the (tests) stanza of
  ;; test/dune links - hence a library module rather than a module of the GUI executable
  ;; (work-stream `migration-marshal-to-text', episode 3). Neither knows about Gtk+.
  (modules marionnet_log configuration meta treeview_row treeview_counters)
  (preprocessor_deps
      (file ../lib/option_extract_p4.cmo)
      (file ../lib/raise_p4.cmo)
      (file ../lib/log_module_loading_p4.cmo)
      (file ../lib/where_p4.cmo)
      (file ../lib/include_type_definitions_p4.cmo)
      (file ../lib/include_as_string_p4.cmo))
  (preprocess (action (run camlp4of
      -I ../../../../_build/default/lib/
      %{read-lines:../lib/camlp4of-include.cfg}
      %{read-lines:../lib/camlp4of-flags.cfg}
      option_extract_p4.cmo raise_p4.cmo log_module_loading_p4.cmo %{input-file}
      )))
  ;; yojson: the JSON codecs of treeview_row / treeview_counters build JSON values, so the
  ;; library is named in their sources - it is not merely inherited from ocamlbricks.
  (libraries str unix threads ocamlbricks yojson))

;; ---
;; --- LIBRARY: marionnet_tap — the sudo+iproute2 tap provider that replaced
;; ---   the root daemon (chantier marionnet-daemon-elimination). Being a
;; ---   library (rather than a module of the GUI executable) is what makes
;; ---   the (test) stanza below able to link it. (wrapped false) keeps the
;; ---   flat name Tap_provider.
;; ---
(library
  (name marionnet_tap)
  (wrapped false)
  (modules tap_provider)
  (preprocessor_deps
      (file ../lib/option_extract_p4.cmo)
      (file ../lib/raise_p4.cmo)
      (file ../lib/log_module_loading_p4.cmo)
      (file ../lib/where_p4.cmo)
      (file ../lib/include_type_definitions_p4.cmo)
      (file ../lib/include_as_string_p4.cmo))
  (preprocess (action (run camlp4of
      -I ../../../../_build/default/lib/
      %{read-lines:../lib/camlp4of-include.cfg}
      %{read-lines:../lib/camlp4of-flags.cfg}
      option_extract_p4.cmo raise_p4.cmo log_module_loading_p4.cmo %{input-file}
      )))
  (libraries str unix threads ocamlbricks marionnet_base))

;; ---
;; --- TEST: proves Tap_provider without the GUI nor a guest image.
;; ---   `dune test' runs it read-only; the live proof (a real tap against the
;; ---   kernel) needs the sudoers rule and is opt-in:
;; ---     MARIONNET_SUDOERS_SCRIPT=bin/scripts/marionnet-sudoers.sh \
;; ---       dune exec bin/tap_provider_test.exe -- --live
;; ---
(test
  (name tap_provider_test)
  (modules tap_provider_test)
  ;; So that the driver can show the rule without the script being installed yet:
  (deps scripts/marionnet-sudoers.sh)
  (preprocessor_deps
      (file ../lib/option_extract_p4.cmo)
      (file ../lib/raise_p4.cmo)
      (file ../lib/log_module_loading_p4.cmo)
      (file ../lib/where_p4.cmo)
      (file ../lib/include_type_definitions_p4.cmo)
      (file ../lib/include_as_string_p4.cmo))
  (preprocess (action (run camlp4of
      -I ../../../../_build/default/lib/
      %{read-lines:../lib/camlp4of-include.cfg}
      %{read-lines:../lib/camlp4of-flags.cfg}
      option_extract_p4.cmo raise_p4.cmo log_module_loading_p4.cmo %{input-file}
      )))
  (libraries str unix threads ocamlbricks marionnet_tap))

;; ---
;; --- EXECUTABLE: marionnet.native (GTK GUI).
;; ---   Everything else (bin/ + bin/gui/ + generated version.ml / meta.ml), minus
;; ---   the modules claimed by the libraries and the test stanza above.
;; ---
(executable
  (public_name marionnet.native)
  (name marionnet)
  (modules (:standard \ marionnet_log configuration meta treeview_row treeview_counters
                        tap_provider tap_provider_test))
  (preprocessor_deps
      (file ../lib/option_extract_p4.cmo)
      (file ../lib/raise_p4.cmo)
      (file ../lib/log_module_loading_p4.cmo)
      (file ../lib/where_p4.cmo)
      (file ../lib/include_type_definitions_p4.cmo)
      (file ../lib/include_as_string_p4.cmo)
      ;; --- The shell scripts embedded by INCLUDE_AS_STRING. Declared here because dune cannot
      ;; --- see through camlp4: without these lines, editing one of them leaves the binary
      ;; --- silently carrying the PREVIOUS version (measured while writing episode 1 of the
      ;; --- `journalisation-profonde' work-stream, on the two guest journal scripts).
      (file scripts/marionnet-relay.00-journal.sh)
      (file scripts/marionnet-relay.zz-journal.sh)
      (file scripts/marionnet-report.sh)
      (file scripts/marionnet-report-watch.sh)
      (file scripts/marionnet-terminal-record.sh)
      (file scripts/can-directory-host-sparse-files.sh))
  (preprocess (action (run camlp4of
      -I ../../../../_build/default/lib/
      %{read-lines:../lib/camlp4of-include.cfg}
      %{read-lines:../lib/camlp4of-flags.cfg}
      option_extract_p4.cmo raise_p4.cmo log_module_loading_p4.cmo %{input-file}
      )))
  ;; cmarkit: treeview_documents renders the guest end-of-session report (Markdown, work-stream
  ;; `journalisation-profonde') into HTML in-process, so that a graded project shows THE SAME page
  ;; on every machine and the raw HTML of a file written inside a guest gets neutralized.
  (libraries str unix threads inotify lablgtk3 lablgtk3-extras cmarkit ocamlbricks marionnet_base marionnet_tap marionnet_sites))

;;; ---
