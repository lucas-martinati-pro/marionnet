     (glob_files "scripts/marionnet-sudoers.sh")
     ;; ---
     (glob_files "share/*")
     (glob_files "filesystems/*")
     (glob_files "kernels/*")
     ;; ---
     (glob_files "images/*")
     (glob_files "images/launcher-icons/*")
     (glob_files "images/treeview-icons/*")
     ;; ---
