{
  "permissions": {
    "allow": [
      "Bash(dune build)",
      "Bash(dune build:*)",
      "Bash(dune runtest:*)",
      "Bash(dune describe:*)",
      "Bash(opam search:*)",
      "Bash(opam show:*)",
      "Bash(opam list:*)",
      "Bash(opam info:*)",
      "Bash(opam var:*)",
      "Bash(opam switch show)",
      "Bash(sherlodoc index:*)",
      "Bash(sherlodoc search:*)",
      "WebFetch(domain:ocaml.org)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/remind-bashbricks.sh",
            "timeout": 10,
            "statusMessage": "rappel bashbricks"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mark-stale.sh",
            "timeout": 10,
            "statusMessage": "fraîcheur index de rôles"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "marionnet": {
      "source": {
        "source": "directory",
        "path": "${CLAUDE_PROJECT_DIR}"
      }
    }
  },
  "enabledPlugins": {
    "marionnet-ocaml-lsp@marionnet": true
  }
}
