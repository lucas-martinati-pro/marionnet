;; ---
;; --- i18n: gettext catalogue compilation + install, coupled to dune (dune-site).
;; ---
;; The .po sources live in ../bin/po/ (versioned). Here dune compiles them to
;; .mo with msgfmt and installs them into the `locale' site declared in
;; dune-project ((sites (share locale))). At run-time bin/gettext.ml locates the
;; catalogues via the generated Marionnet_sites.Sites.locale (relocatable), in
;; head of its candidate cascade, ahead of MARIONNET_LOCALEPREFIX and the
;; CONFIGME-baked Meta.localeprefix (fallback preserved).
;;
;; This directory is intentionally OUTSIDE bin/ : bin/dune sets
;; (include_subdirs unqualified), which forbids a dune file in its subtree, and
;; the generated Sites module must NOT go through bin/'s camlp4of preprocess.
;;
;; Extraction (POT harvesting via the camlp4 gettext_extract_pot_p4) and msgmerge
;; stay in the Makefile (developer tasks, camlp4-coupled) -> chantier camlp4->ppx.
;; ---

;; --- Languages: keep in sync with ../bin/po/LINGUAS
;; --- (de el eo es fr it pt pt_BR ro ru sk tr).
;; --- Only complete catalogues (358/358) are supported and shipped. ar.po and
;; --- zh.po stay versioned in ../bin/po/ but are deliberately NOT listed here
;; --- nor in LINGUAS: they are too incomplete (ar 31/358, zh 0/358) to be worth
;; --- installing, and nobody in the project can proofread them. Re-adding a
;; --- language means editing 3 places: LINGUAS, the (rule) below, the (install).
;; --- Build targets are flat (<lang>.mo); the gettext layout
;; --- <lang>/LC_MESSAGES/marionnet.mo is produced at install time by `as'
;; --- (dune 3.7 forbids a (target) in a sub-directory).
(rule (target fr.mo) (deps ../bin/po/fr.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target it.mo) (deps ../bin/po/it.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target es.mo) (deps ../bin/po/es.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target pt.mo) (deps ../bin/po/pt.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target ro.mo) (deps ../bin/po/ro.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target de.mo) (deps ../bin/po/de.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target el.mo) (deps ../bin/po/el.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target eo.mo) (deps ../bin/po/eo.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target pt_BR.mo) (deps ../bin/po/pt_BR.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target ru.mo) (deps ../bin/po/ru.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target sk.mo) (deps ../bin/po/sk.po) (action (run msgfmt %{deps} -o %{target})))
(rule (target tr.mo) (deps ../bin/po/tr.po) (action (run msgfmt %{deps} -o %{target})))

;; --- Install every .mo into the `locale' site, laid out as
;; --- <lang>/LC_MESSAGES/marionnet.mo (needed by bindtextdomain).
(install
  (section (site (marionnet locale)))
  (files
    (fr.mo as fr/LC_MESSAGES/marionnet.mo)
    (it.mo as it/LC_MESSAGES/marionnet.mo)
    (es.mo as es/LC_MESSAGES/marionnet.mo)
    (pt.mo as pt/LC_MESSAGES/marionnet.mo)
    (ro.mo as ro/LC_MESSAGES/marionnet.mo)
    (de.mo as de/LC_MESSAGES/marionnet.mo)
    (el.mo as el/LC_MESSAGES/marionnet.mo)
    (eo.mo as eo/LC_MESSAGES/marionnet.mo)
    (pt_BR.mo as pt_BR/LC_MESSAGES/marionnet.mo)
    (ru.mo as ru/LC_MESSAGES/marionnet.mo)
    (sk.mo as sk/LC_MESSAGES/marionnet.mo)
    (tr.mo as tr/LC_MESSAGES/marionnet.mo)))

;; --- Tiny library exposing the generated Sites module to bin/gettext.ml.
;; --- No preprocess here (unlike bin/): the generated module is plain OCaml.
(library
  (name marionnet_sites)
  (modules locations)
  (libraries dune-site))

;; Generates module `Locations' whose submodule `Sites' exposes one accessor per
;; site: Marionnet_sites.Locations.Sites.locale : string list. The extra nesting
;; (Locations.Sites) is intrinsic to generate_sites_module; the module is named
;; `locations' (not `sites') to avoid a confusing Sites.Sites path.
(generate_sites_module
  (module locations)
  (sites marionnet))
