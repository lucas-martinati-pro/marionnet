<language id="quagga_zebra" _name="quagga_zebra" version="2.0" _section="Others">
  <metadata>
    <property name="mimetypes">text/x-quagga_zebra</property>
    <property name="globs">*.quagga_zebra</property>
    <property name="line-comment-start">!</property>
  </metadata>

  <styles>
    <style id="keyword" _name="Keyword" map-to="def:keyword"/>
    <style id="comment" _name="Comment" map-to="def:comment"/>
  </styles>

  <definitions>

    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>!</start>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="keywords" style-ref="keyword">
      <keyword>hostname</keyword>
      <keyword>password</keyword>
      <keyword>enable</keyword>
      <!-- -->
      <keyword>interface</keyword>
      <keyword>address</keyword>
      <keyword>ip</keyword>
      <keyword>ipv6</keyword>
      <keyword>forwarding</keyword>
      <keyword>exit</keyword>
      <keyword>route</keyword>
      <!-- -->
      <keyword>log</keyword>
      <keyword>trap</keyword>
      <keyword>stdout</keyword>
      <keyword>no</keyword>
      <keyword>file</keyword>
      <keyword>syslog</keyword>
      <keyword>monitor</keyword>
      <keyword>facility</keyword>
      <keyword>record-priority</keyword>
      <keyword>timestamp</keyword>
      <keyword>precision</keyword>
      <keyword>commands</keyword>
      <keyword>service</keyword>
      <keyword>password-encryption</keyword>
      <keyword>advanced-vty</keyword>
      <keyword>terminal-length</keyword>
      <keyword>line</keyword>
      <keyword>vty</keyword>
      <keyword>banner</keyword>
      <keyword>motd</keyword>
      <keyword>default</keyword>
      <keyword>exec-timeout</keyword>
      <keyword>access-class</keyword>
      <!-- -->
      <keyword>link-detect</keyword>
      <keyword>suppress-ra</keyword>
      <keyword>ra-interval</keyword>
      <keyword>nd</keyword>
      <keyword>prefix</keyword>
      <!-- -->
    </context>

    <context id="quagga_zebra">
      <include>
        <context ref="line-comment"/>
        <context ref="keywords"/>
      </include>
    </context>

  </definitions>

</language>
